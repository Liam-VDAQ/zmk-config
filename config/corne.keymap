/*
 * Corne keymap adapted from the ZSA Moonlander "Smooth Landing" layout
 * (Oryx pxeRD). 72 keys -> 42, so the number row is gone and the
 * Moonlander's top row folds away; everything else keeps its relative place.
 *
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// Layer index matters: ZMK resolves a key by scanning active layers from
// the highest index down. SEL must sit BELOW every layer it selects, or
// its own bindings shadow the target layer's.
#define BASE  0
#define SEL   1
#define SYM   2
#define NAV   3
#define SYS   4
#define MOUSE 5

// Key positions, for the bottom row mods' bilateral hold trigger.
#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35
#define THUMBS 36 37 38 39 40 41

/ {
        behaviors {
                // Bottom row mods, as the original Smooth Landing had them.
                // Strictly bilateral -- the opposite half only -- since these
                // keys sit next to each other and same-hand rolls like "zx"
                // would otherwise misfire.
                bml: bottom_row_mod_left {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "balanced";
                        tapping-term-ms = <280>;
                        quick-tap-ms = <175>;
                        require-prior-idle-ms = <150>;
                        bindings = <&kp>, <&kp>;
                        hold-trigger-key-positions = <KEYS_R THUMBS>;
                        hold-trigger-on-release;
                };

                bmr: bottom_row_mod_right {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "balanced";
                        tapping-term-ms = <280>;
                        quick-tap-ms = <175>;
                        require-prior-idle-ms = <150>;
                        bindings = <&kp>, <&kp>;
                        hold-trigger-key-positions = <KEYS_L THUMBS>;
                        hold-trigger-on-release;
                };

                // Thumb layer taps: tap for the key, hold for the layer.
                // quick-tap-ms lets tap-then-hold auto-repeat, which matters
                // for backspace.
                tlt: thumb_layer_tap {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "hold-preferred";
                        tapping-term-ms = <200>;
                        quick-tap-ms = <200>;
                        bindings = <&mo>, <&kp>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                base_layer {
// -----------------------------------------------------------------------------------------
// | BSPC |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  |  \   |
// | NAV  |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |  '   |
// | SHFT | Z^  | X^  | C^  | V^  |  B  |   |  N  | M^  | ,^  | .^  | /^  | SHFT |
//                    | OPT |BSPC*| SPC |   | ENT |TAB* | CMD |
// Bottom row on hold: Z=CTRL X=SHFT C=ALT V=GUI, mirrored M=GUI ,=ALT .=SHFT /=CTRL
// BSPC* / TAB* = tap the key, hold for the layer selector (see SEL).
// NAV = hold for the arrow layer.
                        bindings = <
   &kp BSPC     &kp Q        &kp W        &kp E         &kp R        &kp T       &kp Y     &kp U        &kp I           &kp O          &kp P           &kp BSLH
   &mo NAV      &kp A        &kp S        &kp D         &kp F        &kp G       &kp H     &kp J        &kp K           &kp L          &kp SEMI        &kp SQT
   &kp LSHFT    &bml LCTRL Z &bml LSHFT X &bml LALT C   &bml LGUI V  &kp B       &kp N     &bmr RGUI M  &bmr RALT COMMA &bmr RSHFT DOT &bmr RCTRL FSLH &kp RSHFT
                                          &kp LALT      &tlt SEL BSPC &kp SPACE  &kp RET   &tlt SEL TAB &kp RGUI
                        >;
                };

                sel_layer {
// -----------------------------------------------------------------------------------------
// Held from either middle thumb. Both hands mirror each other, so whichever
// thumb is down, the other hand picks the layer.
// |      |     |     |     |     |     |   |     |     |     |     |     |      |
// |      |MOUSE| NAV | SYS | SYM | BASE|   | BASE| SYM | SYS | NAV |MOUSE|      |
// |      |     |     |     |     |     |   |     |     |     |     |     |      |
                        bindings = <
   &trans &trans    &trans  &trans  &trans  &trans     &trans   &trans  &trans  &trans  &trans    &trans
   &trans &mo MOUSE &mo NAV &mo SYS &mo SYM &to BASE   &to BASE &mo SYM &mo SYS &mo NAV &mo MOUSE &trans
   &trans &trans    &trans  &trans  &trans  &trans     &trans   &trans  &trans  &trans  &trans    &trans
                            &trans  &trans  &trans     &trans   &trans  &trans
                        >;
                };

                sym_layer {
// -----------------------------------------------------------------------------------------
// | DEL  |  !  |  @  |  {  |  }  |  %  |   |  /  |  7  |  8  |  9  |  *  | F12  |
// |      |  #  |  $  |  (  |  )  |  `  |   |  -  |  4  |  5  |  6  |  +  |      |
// |      |  &  |  ^  |  [  |  ]  |  ~  |   |  =  |  1  |  2  |  3  |  .  |  0   |
//                    (thumbs fall through to base)
                        bindings = <
   &kp DEL   &kp EXCL &kp AT    &kp LBRC &kp RBRC &kp PRCNT   &kp FSLH  &kp N7 &kp N8 &kp N9 &kp ASTRK &kp F12
   &trans    &kp HASH &kp DLLR  &kp LPAR &kp RPAR &kp GRAVE   &kp MINUS &kp N4 &kp N5 &kp N6 &kp PLUS  &trans
   &trans    &kp AMPS &kp CARET &kp LBKT &kp RBKT &kp TILDE   &kp EQUAL &kp N1 &kp N2 &kp N3 &kp DOT   &kp N0
                               &trans   &trans   &trans      &trans    &trans &trans
                        >;
                };

                nav_layer {
// -----------------------------------------------------------------------------------------
// | ESC  |     |     |     |     |     |   |     | END | HOME|ZOOM-|ZOOM0|ZOOM+ |
// |      |     |     |     |     |     |   | LFT | DWN |  UP | RGT |     |      |
// |      |     |     |     |     |     |   |     |PGDN | PGUP|     |     |      |
                        bindings = <
   &kp ESC &trans &trans &trans &trans &trans   &trans   &kp END   &kp HOME  &kp LC(MINUS) &kp LC(N0) &kp LC(EQUAL)
   &trans  &trans &trans &trans &trans &trans   &kp LEFT &kp DOWN  &kp UP    &kp RIGHT     &trans     &trans
   &trans  &trans &trans &trans &trans &trans   &trans   &kp PG_DN &kp PG_UP &trans        &trans     &trans
                         &trans &trans &trans   &trans   &trans    &trans
                        >;
                };

                sys_layer {
// -----------------------------------------------------------------------------------------
// | BOOT | BT0 | BT1 | BT2 | BT3 |BTCLR|   |     | BRI-| BRI+|     |     | BOOT |
// | RESET| UNLK| OUT |     | INS |PSCRN|   |     | VOL-| VOL+| MUTE|     |RESET |
// |      |     |     |     |     |     |   |     | PREV| P/P | NEXT|     |      |
                        bindings = <
   &bootloader &bt BT_SEL 0   &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR   &trans &kp C_BRI_DN &kp C_BRI_UP &trans     &trans &bootloader
   &sys_reset  &studio_unlock &out OUT_TOG &trans       &kp INS      &kp PSCRN    &trans &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE &trans &sys_reset
   &trans      &trans         &trans       &trans       &trans       &trans       &trans &kp C_PREV   &kp C_PP     &kp C_NEXT &trans &trans
                                           &trans       &trans       &trans       &trans &trans       &trans
                        >;
                };

                mouse_layer {
// -----------------------------------------------------------------------------------------
// |      |     |     |  UP | MCLK|     |   |     |     |     |     |     |      |
// |      |     | LFT | DWN | RGT |     |   |     |LCLK |RCLK |     |     |      |
// |      |     |     |     |     |     |   |     |SCR- |SCR+ |     |     |      |
                        bindings = <
   &trans &trans &trans          &mmv MOVE_UP   &mkp MCLK       &trans   &trans &trans         &trans       &trans &trans &trans
   &trans &trans &mmv MOVE_LEFT  &mmv MOVE_DOWN &mmv MOVE_RIGHT &trans   &trans &mkp LCLK      &mkp RCLK    &trans &trans &trans
   &trans &trans &trans          &trans         &trans          &trans   &trans &msc SCRL_DOWN &msc SCRL_UP &trans &trans &trans
                                 &trans         &trans          &trans   &trans &trans         &trans
                        >;
                };
        };
};
